# ============================================================
# ArchitectureSentinel - Frontend Environment Variables
# ============================================================
# ⚠️ ملاحظات مهمة:
# 1. جميع المتغيرات التي تبدأ بـ VITE_ تكون متاحة في المتصفح
# 2. يجب إعادة تشغيل Vite Dev Server بعد أي تعديل على .env
# 3. لا تخزّن أسراراً حقيقية هنا (كل شيء مرئي في Bundle)
# ============================================================

# ============================================================
# API Configuration
# ============================================================
# الرابط الأساسي لـ REST API
# IMPORTANT: يتضمن /v1 لأن الـ Backend يستخدم URI Versioning
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ============================================================
# WebSocket Configuration
# ============================================================
# الرابط الأساسي لاتصالات WebSocket (Socket.IO)
VITE_WS_BASE_URL=ws://localhost:3000

# ============================================================
# Application URLs
# ============================================================
# الرابط الأساسي لتطبيق Frontend (يُستخدم في الروابط المطلقة)
VITE_APP_BASE_URL=http://localhost:5173

# ============================================================
# Application Metadata
# ============================================================
VITE_APP_NAME=ArchitectureSentinel

# ============================================================
# Feature Flags (Optional)
# ============================================================
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MOCK_API=false